# Provider bebas. Isi salah satu:
#  a) AI_GATEWAY_API_KEY  -> otomatis lewat Vercel AI Gateway (35 provider)
#  b) LLM_API_KEY + LLM_BASE_URL -> endpoint OpenAI-compatible mana pun
#  c) OPENAI_API_KEY      -> langsung ke OpenAI (cara lama, tetap didukung)
AI_GATEWAY_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Contoh: anthropic/claude-sonnet-5, google/gemini-..., deepseek/deepseek-v4-pro
LLM_MODEL=
KNOWLEDGE_DIR=knowledge
MIN_RETRIEVAL_SCORE=0.12
MAX_CONTEXT_DOCS=4
RAG_ADMIN_TOKEN=
