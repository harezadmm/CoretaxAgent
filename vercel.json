{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{knowledge/source_files/**,tests/**,tools/**,work/**,.venv/**,.vercel/**,.claude/**,.pytest_cache/**,*.egg-info/**}"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/static/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
